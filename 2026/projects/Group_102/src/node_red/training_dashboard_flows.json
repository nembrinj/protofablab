    {
        "id": "ef7edb157b524b1e",
        "type": "ui-template",
        "z": "58a0e72224ad4a4c",
        "group": "65ff4b572ebc4c80",
        "name": "Independent sample history cards",
        "order": 1,
        "width": "6",
        "height": "10",
        "format": "<template>\n <div class=\"history\">\n  <header><div><div class=\"eyebrow\">YOUR TRAINING JOURNEY · SAMPLE DATA</div><h2>Training history</h2><p>Previous exercise sessions and performance.</p></div><div class=\"count\"><b>{{(msg.payload||[]).length}}</b><span>SESSIONS</span></div></header>\n  <section class=\"summary\">\n   <div><label>TOTAL REPETITIONS</label><b>{{(msg.payload||[]).reduce((a,s)=>a+Number(s.repetitions||0),0)}}</b><small>Across all sessions</small></div>\n   <div><label>AVERAGE HEART RATE</label><b>{{(msg.payload||[]).length?Math.round((msg.payload||[]).reduce((a,s)=>a+Number(s.averageHeartRate||0),0)/(msg.payload||[]).length):0}} <small>BPM</small></b><small>Across all sessions</small></div>\n   <div><label>COMPLETED SESSIONS</label><b>{{(msg.payload||[]).length}}</b><small>Example records</small></div>\n  </section>\n  <article v-for=\"(s,i) in (msg.payload||[])\" :key=\"s.id\" class=\"session\">\n   <div class=\"top\"><div class=\"exercise\"><span class=\"symbol\">✦</span><div><h3>{{s.exercise}}</h3><small>{{s.date}}</small></div></div><span class=\"done\">✓ COMPLETED</span></div>\n   <div class=\"metrics\">\n    <div><span class=\"blue\">↗</span><b>{{s.repetitions}}</b><small>Repetitions</small></div>\n    <div><span class=\"purple\">◷</span><b>{{s.duration}}</b><small>Duration</small></div>\n    <div><span class=\"red\">♥</span><b>{{s.averageHeartRate}} <small>BPM</small></b><small>Average HR</small></div>\n    <div><span class=\"orange\">⌁</span><b>{{s.maxHeartRate}} <small>BPM</small></b><small>Peak HR</small></div>\n   </div>\n   <footer><span>AVERAGE PACE</span><b>{{s.pace}} <small>reps/min</small></b><em>SESSION {{String(i+1).padStart(2,'0')}}</em></footer>\n  </article>\n  <p class=\"disclaimer\">DEMO RECORDS ONLY · Independent from the live ROS 2 training flow.</p>\n </div>\n</template>\n<style>\n.history{padding:5px;color:var(--v-theme-on-surface)}\nheader{display:flex;align-items:center;justify-content:space-between;margin:4px 2px 18px;gap:12px}\n.eyebrow{font-size:10px;letter-spacing:1.5px;color:#5784b8;font-weight:800;margin-bottom:6px}\nh2{font-size:24px;margin:0 0 4px;font-weight:800}header p{font-size:13px;opacity:.65;margin:0}\n.count{width:72px;height:72px;border-radius:18px;background:#e4efff;color:#205a9b;display:flex;flex-direction:column;align-items:center;justify-content:center}\n.count b{font-size:26px}.count span{font-size:9px;letter-spacing:1px;font-weight:800}\n.summary{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:16px}\n.summary>div{padding:14px;border:1px solid rgba(120,135,155,.2);border-radius:14px;background:var(--v-theme-surface)}\n.summary label{font-size:9px;letter-spacing:.7px;font-weight:800;opacity:.6;display:block}\n.summary b{display:block;font-size:25px;margin:7px 0 2px}.summary b small{font-size:11px}\n.summary small{font-size:10px;opacity:.6}\n.session{border:1px solid rgba(120,135,155,.2);border-radius:16px;padding:15px;margin-bottom:12px;background:var(--v-theme-surface);box-shadow:0 3px 12px rgba(30,50,80,.04)}\n.top{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;margin-bottom:14px}\n.exercise{display:flex;gap:10px;align-items:center}.symbol{width:38px;height:38px;border-radius:12px;background:#eaf2ff;color:#2868ad;display:grid;place-items:center}\nh3{font-size:15px;margin:0 0 3px}.exercise small{font-size:11px;opacity:.62}\n.done{background:#e5f5ed;color:#217a4c;border-radius:20px;padding:6px 9px;font-size:9px;font-weight:850}\n.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding:12px 0;border-top:1px solid rgba(120,135,155,.14);border-bottom:1px solid rgba(120,135,155,.14)}\n.metrics>div{display:grid;grid-template-columns:28px auto;align-items:center;column-gap:6px}\n.metrics span{grid-row:span 2;width:27px;height:27px;border-radius:9px;display:grid;place-items:center}\n.metrics b{font-size:14px}.metrics b small{font-size:8px}.metrics div>small{font-size:9px;opacity:.62}\n.blue{background:#eaf2ff;color:#2868ad}.purple{background:#f0ebff;color:#7453b7}.red{background:#fff0f0;color:#d64d58}.orange{background:#fff4e5;color:#b87522}\nfooter{display:flex;align-items:center;gap:7px;padding-top:10px;font-size:9px;letter-spacing:.6px;font-weight:750;opacity:.75}\nfooter b{font-size:12px;color:#3979bd;letter-spacing:0}footer b small{font-size:9px}footer em{margin-left:auto;font-style:normal;opacity:.55}\n.disclaimer{text-align:center;font-size:9px;letter-spacing:.5px;opacity:.5;margin-top:14px}\n@media(max-width:600px){.summary{grid-template-columns:1fr}.metrics{grid-template-columns:repeat(2,1fr);row-gap:12px}h2{font-size:21px}}\n</style>",
        "storeOutMessages": true,
        "resendOnRefresh": true,
        "templateScope": "local",
