    {
        "id": "d7d6c5fd5b954bac",
        "type": "comment",
        "z": "c617bcffbb494d8c",
        "name": "ROS 2 via rosbridge (ws://localhost:9090)",
        "info": "Start in this order (all with ROS_DOMAIN_ID=102):\n1. pixi run ros2 launch rosbridge_server rosbridge_websocket_launch.xml\n2. node-red\n3. pixi run ros2 launch adaptive-trainning-assistance training_assistant.launch.py\n\nTopics:\n/exercise/rep_event (std_msgs/String, JSON: repetitions, repetition_duration_seconds, pace_reps_per_minute, exercise_duration_seconds)\n/training/status (std_msgs/String)\n/training/feedback (std_msgs/String)\n/heart_rate (std_msgs/Float32, bpm)",
        "x": 260,
        "y": 120,
        "wires": []
    },
    {
        "id": "ec9bea203def4bea",
        "type": "function",
        "z": "c617bcffbb494d8c",
        "name": "Normalize ROS 2 messages",
        "func": "// All ROS 2 Subscribe nodes connect here.\n// ros2-suite sends the topic name in msg.topic and the ROS message in msg.payload.\n// std_msgs messages normally look like { data: <value> }.\nconst topic = String(msg.topic || msg.ros?.topic || \"\");\nconst raw = (msg.payload && Object.prototype.hasOwnProperty.call(msg.payload, \"data\"))\n    ? msg.payload.data : msg.payload;\n\nconst num = Number(raw);\nconst output = [null, null, null, null, null, null, null];\nconst state = context;\n\nfunction sendText(index, value, topicName) {\n    const out = { ...msg, topic: topicName, payload: value, timestamp: Date.now() };\n    output[index] = out;\n}\n\nif (topic === \"/exercise/repetitions\") {\n    if (!Number.isFinite(num)) return null;\n    state.set(\"repetitions\", num);\n    sendText(0, num, \"Repetitions\");\n    const duration = Number(state.get(\"durationSeconds\"));\n    if (duration > 0) sendText(2, (num / duration * 60).toFixed(1), \"Pace\");\n} else if (topic === \"/exercise/duration\") {\n    if (!Number.isFinite(num)) return null;\n    state.set(\"durationSeconds\", num);\n    const mins = Math.floor(num / 60);\n    const secs = Math.floor(num % 60);\n    sendText(1, `${String(mins).padStart(2,\"0\")}:${String(secs).padStart(2,\"0\")}`, \"Duration\");\n    const reps = Number(state.get(\"repetitions\"));\n    if (num > 0 && Number.isFinite(reps)) sendText(2, (reps / num * 60).toFixed(1), \"Pace\");\n} else if (topic === \"/exercise/repetition_duration\") {\n    if (!Number.isFinite(num)) return null;\n    sendText(3, `${num.toFixed(2)} s`, \"Last repetition\");\n} else if (topic === \"/exercise/rep_event\") {\n    // One JSON message per repetition from exercise_counter.\n    let e;\n    try { e = JSON.parse(raw); } catch (err) { return null; }\n    const secs = Number(e.exercise_duration_seconds) || 0;\n    sendText(0, e.repetitions, \"Repetitions\");\n    sendText(1, `${String(Math.floor(secs / 60)).padStart(2, \"0\")}:${String(Math.floor(secs % 60)).padStart(2, \"0\")}`, \"Duration\");\n    sendText(2, Number(e.pace_reps_per_minute).toFixed(1), \"Pace\");\n    sendText(3, `${Number(e.repetition_duration_seconds).toFixed(2)} s`, \"Last repetition\");\n} else if (topic === \"/training/status\") {\n    sendText(4, String(raw), \"Training status\");\n} else if (topic === \"/training/feedback\" || topic === \"/exercise/feedback\") {\n    sendText(5, String(raw), \"Coach feedback\");\n} else if (/heart.?rate|heartrate|bpm/i.test(topic)) {\n    // Connect the real HR subscribe node here once its actual topic is confirmed.\n    if (!Number.isFinite(num)) return null;\n    sendText(6, Math.round(num), \"Heart rate\");\n}\nreturn output;",
        "outputs": 7,
        "timeout": 0,
        "noerr": 0,
        "initialize": "context.set('repetitions', 0);\ncontext.set('durationSeconds', 0);",
        "finalize": "",
