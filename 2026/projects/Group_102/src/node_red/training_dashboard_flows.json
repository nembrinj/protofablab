        "func": "const demo = [\n {id:\"demo-01\",date:\"18 Nov 2026 · 18:10\",exercise:\"Arm raises\",repetitions:20,duration:\"04:32\",averageHeartRate:112,maxHeartRate:128,pace:\"4.4\"},\n {id:\"demo-02\",date:\"17 Nov 2026 · 17:25\",exercise:\"Arm raises\",repetitions:18,duration:\"04:08\",averageHeartRate:109,maxHeartRate:124,pace:\"4.4\"},\n {id:\"demo-03\",date:\"16 Nov 2026 · 11:40\",exercise:\"Arm raises\",repetitions:15,duration:\"03:51\",averageHeartRate:106,maxHeartRate:121,pace:\"3.9\"},\n {id:\"demo-04\",date:\"14 Nov 2026 · 16:05\",exercise:\"Arm raises\",repetitions:22,duration:\"05:02\",averageHeartRate:115,maxHeartRate:132,pace:\"4.4\"},\n {id:\"demo-05\",date:\"12 Nov 2026 · 10:15\",exercise:\"Arm raises\",repetitions:12,duration:\"03:20\",averageHeartRate:102,maxHeartRate:116,pace:\"3.6\"}\n];\nmsg.payload=demo;\nreturn msg;",
