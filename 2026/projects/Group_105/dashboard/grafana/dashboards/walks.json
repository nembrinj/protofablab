      {
        "name": "patient",
        "label": "Patient",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "rehab-influxdb"
        },
        "definition": "SHOW TAG VALUES FROM \"walk\" WITH KEY = \"patient_id\"",
        "query": "SHOW TAG VALUES FROM \"walk\" WITH KEY = \"patient_id\"",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "options": [],
        "current": {}
      },
      {
        "name": "session",
        "label": "Session",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "rehab-influxdb"
        },
        "definition": "SHOW TAG VALUES FROM \"walk\" WITH KEY = \"session_id\" WHERE \"patient_id\" = '$patient'",
        "query": "SHOW TAG VALUES FROM \"walk\" WITH KEY = \"session_id\" WHERE \"patient_id\" = '$patient'",
        "refresh": 2,
        "sort": 2,
