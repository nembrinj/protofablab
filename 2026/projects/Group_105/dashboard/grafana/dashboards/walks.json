      "title": "Sessions",
      "datasource": {
        "type": "influxdb",
        "uid": "rehab-influxdb"
      },
      "description": "One row per session, newest first. Steps per minute and speed are the means over the measured walks.",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "noValue": "0"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Steps per minute"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Speed (m/s)"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 2
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Session",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "rehab-influxdb"
          },
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT count(\"walk\") AS \"Walks\", sum(\"stops\") AS \"Stops\" FROM \"walk\" WHERE \"patient_id\" = '$patient' AND $timeFilter GROUP BY \"session_id\""
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "rehab-influxdb"
          },
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT count(\"walk\") AS \"Measured\", mean(\"cadence_spm\") AS \"Steps per minute\", mean(\"speed_mps\") AS \"Speed (m/s)\" FROM \"walk\" WHERE \"measured\" = true AND \"patient_id\" = '$patient' AND $timeFilter GROUP BY \"session_id\""
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "session_id",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(?!Time).*"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {
              "session_id": "Session"
            },
            "indexByName": {
              "session_id": 0,
              "Walks": 1,
              "Measured": 2,
              "Stops": 3,
              "Steps per minute": 4,
              "Speed (m/s)": 5
            }
          }
        }
